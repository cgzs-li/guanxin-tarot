{
  "name": "guanxin-tarot",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "routes": [{ "pattern": "tarot.ruichi0201.cn", "custom_domain": true }],
  "build": { "command": "node tools/build_workers.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "FLOWBEE_BASE_URL": "https://flowbee.top/v1",
    "FLOWBEE_MODEL": "agnes-3.0-flash",
    "GUANXIN_SITE_ENABLED": "true",
    "GUANXIN_AI_ENABLED": "false"
  },
  "durable_objects": { "bindings": [{ "name": "AI_GATEWAY", "class_name": "AIGateway" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AIGateway"] }],
  "observability": { "enabled": false }
}
